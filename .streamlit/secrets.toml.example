# Streamlit secrets configuration template
# Copy this file to .streamlit/secrets.toml and fill in your actual credentials.
# DO NOT commit .streamlit/secrets.toml to GitHub!

# Database Configuration (PostgreSQL)
DB_HOST = "localhost"
DB_PORT = "5432"
DB_NAME = "expense_01"
DB_USER = "postgres"
DB_PASSWORD = "your_postgres_password_here"

# Google Gemini AI API Key
GEMINI_API_KEY = "your_google_gemini_api_key_here"

# Feedback Email Configuration (Optional - for Gmail SMTP)
SMTP_EMAIL = "your_gmail_address@gmail.com"
SMTP_APP_PASSWORD = "your_16_char_google_app_password"
SMTP_HOST = "smtp.gmail.com"
SMTP_PORT = 465
FEEDBACK_TO_EMAIL = "feedback_receiver@example.com"

# Contact Info (Optional)
CONTACT_EMAIL = "support@example.com"
CONTACT_PHONE = "+91 00000 00000"
